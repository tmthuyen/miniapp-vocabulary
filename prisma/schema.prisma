generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VipPlan {
  free
  vip_basic
  vip_pro
}

enum VocabularyDifficulty {
  Easy
  Medium
  Hard
}

enum UserProfileStatus {
  active
  pending
  inactive
  deleted
  banned
  restricted
}



model Role {
  id   String @id 
  code String @unique
  name String @unique

  created_at DateTime @default(now())
  created_by String?  
  updated_at DateTime @updatedAt
  updated_by String?  

	user_roles UserRole[]

  @@map("roles")
}

model UserRole {
  id      String @id 
  user_id String 
  role_id String 

  user_profile    UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role    Role        @relation(fields: [role_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  created_by String?  
  updated_at DateTime @updatedAt
  updated_by String?  
  
  @@unique([user_id, role_id])
  @@index([user_id])
  @@index([role_id])
  @@map("user_roles")
}

model UserProfile {
  id            String   @id  
  full_name     String?
  avatar_url    String?
  target_band   Float?
  vip_plan      VipPlan  @default(free)
  vip_expired_at     DateTime?
  status        UserProfileStatus @default(active)

  created_at DateTime @default(now())
  created_by String?  
  updated_at DateTime @updatedAt
  updated_by String?  

	sessions          Session[]
	auth_providers    UserAuthProvider[]
	user_roles        UserRole[]
	vocabularies        Vocabulary[]
	vocabulary_sets      VocabularySet[]

  @@map("user_profiles")
}

model Session {
  id            String   @id 
  user_id       String   
  session_token String   @unique
  issued_at   DateTime
  expires_at    DateTime
  revoked_at	 DateTime?
	
  created_at DateTime @default(now())
  created_by String?  
  updated_at DateTime @updatedAt
  updated_by String?  

  user_profile          UserProfile     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}


model UserAuthProvider {
	id             String   @id 
	user_id        String   
	provider_type        String @default("local") // e.g., "local", "google", "facebook"
	provider_user_id String? // e.g., the user ID from the provider (for "local", this can be null)
	email 				 String? @unique
	password_hash String?
    is_verified Boolean @default(false)

	created_at DateTime @default(now())
	created_by String?  
	updated_at DateTime @updatedAt
	updated_by String?  

	user_profile          UserProfile     @relation(fields: [user_id], references: [id], onDelete: Cascade)

	@@unique([provider_type, provider_user_id])
	@@index([user_id])
	@@map("user_auth_providers")
}

model VocabularySet {
  id          String    @id 
  user_id     String    
  name        String
  description String?
  is_published Boolean  @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user        UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  vocabularies Vocabulary[]

  @@index([user_id])
  @@index([is_published])
  @@map("vocabulary_sets")
}

model Vocabulary {
  id          String               @id 
  user_id     String               
  set_id      String?              
  word        String
  ipa         String?
  definition  String?
  example     String?
  category    String
  difficulty  VocabularyDifficulty @default(Medium)
  created_at  DateTime             @default(now())

  user        UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)
  set         VocabularySet? @relation(fields: [set_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([category])
  @@index([set_id])
  @@map("vocabularies")
}
