generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  user
}

enum VipPlan {
  free
  vip_basic
  vip_pro
}

enum VocabularyDifficulty {
  Easy
  Medium
  Hard
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  password_hash String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  profile       UserProfile?
  sessions      Session[]

  @@map("users")
}

model Session {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  session_token String   @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("sessions")
}

model UserProfile {
  id             String   @id @db.Uuid
  full_name      String?
  avatar_url     String?
  target_band    Float?
  role           UserRole @default(user)
  vip_plan       VipPlan  @default(free)
  vip_expired_at DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user           User     @relation(fields: [id], references: [id], onDelete: Cascade)
  vocabularies   Vocabulary[]

  @@map("profiles")
}

model Vocabulary {
  id          String               @id @default(uuid()) @db.Uuid
  user_id     String               @db.Uuid
  word        String
  ipa         String?
  definition  String?
  example     String?
  category    String
  difficulty  VocabularyDifficulty @default(Medium)
  created_at  DateTime             @default(now())

  user        UserProfile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([category])
  @@map("vocabularies")
}